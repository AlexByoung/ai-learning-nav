---
// Decorative banner: hue-tinted gradient with a faint "network" of nodes. Pure CSS/SVG, no image assets.
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;

// Deterministic pseudo-random layout so every build renders the same picture.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const nodes = Array.from({ length: 34 }, () => ({ x: rand() * 1200, y: rand() * 400, r: 1.5 + rand() * 3 }));
const edges: [number, number][] = [];
nodes.forEach((a, i) => {
  nodes.forEach((b, j) => {
    if (j > i && Math.hypot(a.x - b.x, a.y - b.y) < 190) edges.push([i, j]);
  });
});
---

<div class:list={['banner', { home }]} aria-hidden="true">
  <svg class="net" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice">
    {edges.map(([i, j]) => <line x1={nodes[i].x} y1={nodes[i].y} x2={nodes[j].x} y2={nodes[j].y} />)}
    {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} />)}
  </svg>
</div>

<style>
  .banner {
    position: absolute;
    inset: 0 0 auto;
    height: var(--banner-height);
    min-height: 200px;
    overflow: hidden;
    background:
      radial-gradient(60% 90% at 15% 10%, var(--banner-c), transparent 70%),
      radial-gradient(55% 80% at 85% 30%, var(--banner-b), transparent 70%),
      linear-gradient(160deg, var(--banner-a), var(--banner-b));
  }

  .banner {
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.45;
  }

  .net line {
    stroke: rgb(255 255 255 / 0.45);
    stroke-width: 0.8;
  }

  .net circle {
    fill: rgb(255 255 255 / 0.85);
  }
</style>
