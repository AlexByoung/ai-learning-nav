---
// Material Symbols (Apache-2.0) rendered to inline SVG at build time; no runtime requests.
import { icons } from '@iconify-json/material-symbols';
import { getIconData, iconToSVG } from '@iconify/utils';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const data = getIconData(icons, name);
if (!data) throw new Error(`Unknown icon "material-symbols:${name}"`);
const { attributes, body } = iconToSVG(data, { height: '1em' });
---

<svg {...attributes} class:list={['icon', className]} aria-hidden="true" focusable="false" set:html={body} />

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.125em;
  }
</style>
