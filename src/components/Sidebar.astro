---
import Icon from './Icon.astro';
import { t } from '../i18n';
import { CATEGORIES, CATEGORY_ICONS, LEVELS, PROGRESS_STATES } from '../data/taxonomy';
import { getCourses } from '../lib/data';
import { withBase } from '../lib/url';

const courses = await getCourses();
const count = (key: 'category' | 'level', value: string) => courses.filter((c) => c[key] === value).length;
---

<div class="sidebar-inner">
  <section class="card-base widget" aria-labelledby="w-progress" data-progress-stats data-course-ids={courses.map((c) => c.id).join(',')}>
    <h2 id="w-progress" class="bar-title">{t.sidebar.progress}</h2>
    <dl class="stats">
      {
        PROGRESS_STATES.map((s) => (
          <div class={`stat stat-${s}`}>
            <dt>{t.progress.states[s]}</dt>
            <dd data-progress-count={s}>0</dd>
          </div>
        ))
      }
    </dl>
    <div class="bar" aria-hidden="true">
      {PROGRESS_STATES.map((s) => <span class={`bar-${s}`} data-progress-bar={s} data-total={courses.length} />)}
    </div>
    <p class="note text-50">
      <span data-progress-empty>{t.progress.empty}</span>
      <span data-storage-warning hidden>{t.progress.unavailable}</span>
    </p>
    <p class="note text-30">{t.progress.total(courses.length)} · {t.progress.storageNote}</p>
  </section>

  <section class="card-base widget desktop-only" aria-labelledby="w-categories">
    <h2 id="w-categories" class="bar-title">{t.sidebar.categories}</h2>
    <ul class="links">
      {
        CATEGORIES.map((key) => (
          <li>
            <a class="row-link" href={withBase(`courses/?category=${key}`)} data-filter-link="category" data-value={key}>
              <Icon name={CATEGORY_ICONS[key]} class="row-icon" />
              <span class="row-text">{t.categories[key].name}</span>
              <span class="badge">{count('category', key)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card-base widget desktop-only" aria-labelledby="w-levels">
    <h2 id="w-levels" class="bar-title">{t.sidebar.levels}</h2>
    <div class="chips">
      {
        LEVELS.map((key) => (
          <a class={`btn-regular chip level-${key}`} href={withBase(`courses/?level=${key}`)} data-filter-link="level" data-value={key}>
            <span class="level-dot" />
            {t.levels[key]}
            <span class="chip-count">{count('level', key)}</span>
          </a>
        ))
      }
    </div>
  </section>
</div>

<style>
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .widget {
    padding: 1rem 1rem 1.1rem;
  }

  /* Below the two-column breakpoint these duplicate the page's own category cards / filter chips. */
  @media (max-width: 1023px) {
    .desktop-only {
      display: none;
    }
  }

  .widget .bar-title {
    margin: 0 0 0.6rem 0.25rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }

  .stat {
    border-radius: 0.6rem;
    padding: 0.5rem 0.25rem;
    background: var(--btn-regular-bg);
    text-align: center;
  }

  .stat dt {
    font-size: 0.8rem;
    color: var(--text-50);
  }

  .stat dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .stat-want dd {
    color: var(--state-want);
  }

  .stat-doing dd {
    color: var(--state-doing);
  }

  .stat-done dd {
    color: var(--state-done);
  }

  .bar {
    display: flex;
    height: 6px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--btn-regular-bg);
  }

  .bar span {
    width: 0;
    transition: width 0.3s ease;
  }

  .bar-want {
    background: var(--state-want);
  }

  .bar-doing {
    background: var(--state-doing);
  }

  .bar-done {
    background: var(--state-done);
  }

  .note {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border-radius: 0.5rem;
    color: var(--text-75);
    transition: background-color 0.15s ease, color 0.15s ease, padding 0.15s ease;
  }

  .row-link:hover {
    background: var(--btn-plain-bg-hover);
    color: var(--primary);
    padding-left: 0.75rem;
  }

  .row-icon {
    font-size: 1.15rem;
    color: var(--btn-content);
  }

  .row-text {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge {
    min-width: 2rem;
    height: 1.75rem;
    padding: 0 0.5rem;
    border-radius: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips .chip {
    height: 2.25rem;
  }

  .level-dot {
    width: 6px;
    height: 6px;
    border-radius: 6px;
    background: var(--level);
  }

  .chip-count {
    font-weight: 700;
    opacity: 0.7;
  }
</style>
