---
import '../styles/global.css';
import { t } from '../i18n';
import { withBase } from '../lib/url';
import { credits } from '../data/pictures';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = t.site.description } = Astro.props;
const fullTitle = title ? `${title}｜${t.site.name}` : t.site.name;
const current = Astro.url.pathname;
const nav = [
  { href: withBase('courses/'), label: t.nav.courses },
  { href: withBase('paths/'), label: t.nav.paths },
];
const startHref = withBase('paths/agent-user-to-internals/');

// Footer mark: each character of the name knocked out of its own block; heights step like a stack.
const markChars = ['A', 'I', '学', '习', '导', '航'];
const markHeights = [100, 78, 92, 64, 86, 72];
const markTones = ['accent', 'ink', 'layer-2', 'ink', 'layer-3', 'layer-1'];
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#18191b" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="bar wrap">
      <a class="brand" href={withBase('')} aria-label={t.site.name}>
        <svg class="brand-mark" viewBox="0 0 24 29" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => <rect x="0" y={i * 6} width="24" height="5" class:list={[{ lit: i === 4 }]} />)}
        </svg>
        <span>{t.site.name}</span>
      </a>
      <nav aria-label={t.nav.label}>
        {
          nav.map((item) => (
            <a class="link" href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="button bar-action" href={startHref}>{t.nav.start}</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <div class="mark" aria-hidden="true">
        {
          markChars.map((ch, i) => (
            <span class={`block tone-${markTones[i]}`} style={`--h:${markHeights[i]}%`}>
              <span>{ch}</span>
            </span>
          ))
        }
      </div>
      <div class="foot-grid">
        <div>
          <h2 class="foot-title">{t.footer.pages}</h2>
          <ul class="foot-list">
            <li><a class="link" href={withBase('')}>{t.footer.home}</a></li>
            <li><a class="link" href={withBase('courses/')}>{t.nav.courses}</a></li>
            <li><a class="link" href={withBase('paths/')}>{t.nav.paths}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="foot-title">{t.footer.data}</h2>
          <ul class="foot-list">
            <li><a class="link" href="https://github.com/AlexByoung/ai-learning-nav#新增一门课" target="_blank" rel="noopener noreferrer">{t.footer.readme}</a></li>
            <li><a class="link" href="https://github.com/AlexByoung/ai-learning-nav" target="_blank" rel="noopener noreferrer">{t.footer.source}</a></li>
          </ul>
        </div>
        <div class="foot-about">
          <p>{t.site.disclaimer}</p>
          <p>{t.progress.storageNote}</p>
        </div>
      </div>
      {
        credits.length > 0 && (
          <p class="credits">
            {t.footer.credits}：
            {credits.map((c, i) => (
              <>
                {i > 0 && '；'}
                <a class="link-plain" href={c.page} target="_blank" rel="noopener noreferrer">
                  {c.title}
                </a>
                {c.byline}
              </>
            ))}
            。
          </p>
        )
      }
      <div class="foot-last">
        <p>© 2026 {t.site.name}</p>
        <a class="button small-button" href="#main">{t.footer.top}</a>
      </div>
    </footer>

    <script>
      import '../scripts/progress';
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--margin);
    top: -4rem;
    z-index: 10;
    padding: 0.75rem 1rem;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .skip:focus {
    top: 0.75rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-mark {
    width: 1.35rem;
  }

  .brand-mark rect {
    fill: var(--ink);
  }

  .brand-mark rect.lit {
    fill: var(--accent);
  }

  nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .bar-action {
    min-height: 2.75rem;
  }

  @media (max-width: 30em) {
    .brand span {
      display: none;
    }
    .bar-action {
      padding: 0 1rem;
    }
  }

  .foot {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 2rem;
  }

  .mark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: clamp(7rem, 24svh, 15rem);
  }

  .block {
    flex: 1;
    height: var(--h);
    display: flex;
    align-items: flex-end;
    padding: 0 0 0.04em 0.08em;
    font-size: clamp(3rem, 9vw, 9.5rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--bg);
    overflow: hidden;
  }

  .tone-accent {
    background: var(--accent);
  }

  .tone-ink {
    background: var(--ink);
  }

  .tone-layer-1 {
    background: var(--layer-1);
  }

  .tone-layer-2 {
    background: var(--layer-2);
  }

  .tone-layer-3 {
    background: var(--layer-3);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem var(--gutter);
    margin-top: 3.5rem;
  }

  .foot-about {
    grid-column: 1 / -1;
  }

  @media (min-width: 64em) {
    .foot-grid {
      grid-template-columns: 2fr 2fr 4fr 4fr;
    }
    .foot-about {
      grid-column: 4;
    }
  }

  .foot-title {
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .foot-list li + li {
    margin-top: 0.25rem;
  }

  .foot-list a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
  }

  .foot-about p + p {
    margin-top: 0.75rem;
  }

  .foot-about p,
  .credits {
    color: var(--muted);
  }

  .credits {
    margin-top: 3rem;
    max-width: 62ch;
  }

  .credits a {
    color: var(--ink);
  }

  .foot-last {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    color: var(--muted);
  }

  .small-button {
    min-height: 2.75rem;
    padding: 0 1rem;
  }
</style>
