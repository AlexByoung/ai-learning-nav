---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t } from '../i18n';
import { withBase } from '../lib/url';
---

<Base title={t.notFound.title}>
  <div class="card-base box">
    <span class="meta-icon big"><Icon name="sentiment-neutral-outline-rounded" /></span>
    <h1 class="bar-title">{t.notFound.title}</h1>
    <p class="text-50">{t.notFound.body}</p>
    <a class="btn-regular back" href={withBase('')}><Icon name="home-outline-rounded" />{t.notFound.back}</a>
  </div>
</Base>

<style>
  .box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
  }

  .big {
    width: 3rem;
    height: 3rem;
    font-size: 1.75rem;
    border-radius: 0.8rem;
  }

  .back {
    height: 2.5rem;
    padding: 0 1rem;
    border-radius: 0.6rem;
    font-weight: 700;
  }
</style>
