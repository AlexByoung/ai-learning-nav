---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
import { withBase } from '../lib/url';
---

<Base title={t.notFound.title}>
  <div class="page wrap">
    <h1 class="head">{t.notFound.title}</h1>
    <p class="muted">{t.notFound.body}</p>
    <a class="button" href={withBase('')}>{t.notFound.back}</a>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(4rem, 12vw, 10rem);
  }
</style>
