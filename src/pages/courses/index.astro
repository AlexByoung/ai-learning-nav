---
import Base from '../../layouts/Base.astro';
import CourseRow from '../../components/CourseRow.astro';
import { t } from '../../i18n';
import { CATEGORIES, LEVELS } from '../../data/taxonomy';
import { getCourses } from '../../lib/data';

const courses = await getCourses();
// Listed by layer, top to bottom; within a layer, in YAML order.
const ordered = CATEGORIES.flatMap((layer) => courses.filter((c) => c.category === layer));
const groups = [
  { name: 'category', label: t.courses.layerLabel, options: CATEGORIES.map((c) => ({ value: c, label: t.layers[c].short })) },
  { name: 'level', label: t.courses.levelLabel, options: LEVELS.map((l) => ({ value: l, label: t.levels[l] })) },
];
---

<Base title={t.courses.title} description={t.courses.summary(courses.length)}>
  <div class="page wrap">
    <div class="title-row">
      <h1>{t.courses.title}</h1>
      <p class="muted">{t.courses.summary(courses.length)}</p>
    </div>

    <div class="filters" data-filters>
      <label class="search">
        <span class="sr-only">{t.courses.searchLabel}</span>
        <input type="search" name="q" placeholder={t.courses.searchPlaceholder} autocomplete="off" enterkeyhint="search" data-search-input />
      </label>
      {
        groups.map((g) => (
          <div class="group" role="group" aria-label={g.label}>
            <span class="group-label">{g.label}</span>
            <div class="chips" data-chip-group={g.name}>
              <button type="button" data-value="" aria-pressed="true">
                {t.courses.all}
              </button>
              {g.options.map((o) => (
                <button type="button" data-value={o.value} aria-pressed="false">
                  {o.label}
                </button>
              ))}
            </div>
          </div>
        ))
      }
      <div class="group" role="group" aria-label={t.courses.otherLabel}>
        <span class="group-label">{t.courses.otherLabel}</span>
        <div class="chips">
          <button type="button" data-flag="video" aria-pressed="false">{t.courses.hasVideo}</button>
          <button type="button" data-flag="free" aria-pressed="false">{t.courses.freeOnly}</button>
        </div>
      </div>
      <div class="result">
        <p class="nums" aria-live="polite" data-result-count>{t.courses.resultCount(courses.length, courses.length)}</p>
        <button type="button" class="reset link-plain" data-reset>{t.courses.reset}</button>
      </div>
      <noscript><p class="muted">{t.courses.noscript}</p></noscript>
    </div>

    <div class="rows" data-course-grid>
      {ordered.map((course) => <CourseRow course={course} />)}
    </div>
    <p class="empty" data-empty hidden>{t.courses.empty}</p>
  </div>
</Base>

<script>
  import { t } from '../../i18n';

  type Filters = { q: string; category: string; level: string; video: boolean; free: boolean };

  const rows = [...document.querySelectorAll<HTMLElement>('[data-course-grid] [data-course-id]')];
  const count = document.querySelector<HTMLElement>('[data-result-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const search = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const groups = [...document.querySelectorAll<HTMLElement>('[data-chip-group]')];
  const flags = [...document.querySelectorAll<HTMLButtonElement>('[data-flag]')];

  const p = new URLSearchParams(location.search);
  let state: Filters = { q: p.get('q') ?? '', category: p.get('category') ?? '', level: p.get('level') ?? '', video: p.get('video') === '1', free: p.get('free') === '1' };

  function render() {
    search.value = state.q;
    for (const group of groups) {
      const key = group.dataset.chipGroup as 'category' | 'level';
      const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
      // Unknown values from the URL fall back to "all".
      if (!buttons.some((b) => b.dataset.value === state[key])) state[key] = '';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.value === state[key]));
    }
    for (const b of flags) b.setAttribute('aria-pressed', String(state[b.dataset.flag as 'video' | 'free']));

    const terms = state.q.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const row of rows) {
      const ok =
        (!state.category || row.dataset.category === state.category) &&
        (!state.level || row.dataset.level === state.level) &&
        (!state.video || row.dataset.video === 'true') &&
        (!state.free || row.dataset.free === 'true') &&
        terms.every((term) => (row.dataset.search ?? '').includes(term));
      row.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = t.courses.resultCount(shown, rows.length);
    empty.hidden = shown > 0;

    const next = new URLSearchParams();
    if (state.q.trim()) next.set('q', state.q.trim());
    if (state.category) next.set('category', state.category);
    if (state.level) next.set('level', state.level);
    if (state.video) next.set('video', '1');
    if (state.free) next.set('free', '1');
    const qs = next.toString();
    history.replaceState(null, '', (qs ? `?${qs}` : location.pathname) + location.hash);
  }

  search.addEventListener('input', () => {
    state.q = search.value;
    render();
  });
  for (const group of groups) {
    group.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest<HTMLButtonElement>('button[data-value]');
      if (!btn) return;
      state[group.dataset.chipGroup as 'category' | 'level'] = btn.dataset.value ?? '';
      render();
    });
  }
  for (const b of flags) {
    b.addEventListener('click', () => {
      const key = b.dataset.flag as 'video' | 'free';
      state[key] = !state[key];
      render();
    });
  }
  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    state = { q: '', category: '', level: '', video: false, free: false };
    render();
  });

  render();
</script>

<style>
  .page {
    padding-top: 2rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .title-row h1 {
    font-size: var(--step-statement);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .filters {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    padding: 1.25rem var(--margin);
    margin-inline: calc(var(--margin) * -1);
    background: var(--surface);
  }

  @media (min-width: 64em) {
    .filters {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--gutter);
      margin-inline: 0;
      padding: 1.5rem 1.75rem;
    }
    .search {
      grid-row: span 3;
    }
    .result {
      grid-column: 1 / -1;
    }
  }

  .search input {
    width: 100%;
    min-height: 3rem;
    padding: 0 1rem;
    border: 0;
    background: var(--bg);
    color: var(--ink);
    font-size: max(1rem, var(--step-body));
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }

  .group {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .group-label {
    flex: none;
    width: 2.5rem;
    line-height: 2.75rem;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .chips button {
    min-height: 2.75rem;
    padding: 0 0.9rem;
    background: var(--bg);
    color: var(--muted);
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease,
      transform var(--t-press) var(--ease-out);
  }

  .chips button:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .chips button:hover {
      color: var(--ink);
    }
  }

  .chips button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
  }

  .result {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: var(--muted);
  }

  .reset {
    min-height: 2.75rem;
    color: var(--ink);
  }

  .rows {
    display: grid;
    gap: 4px;
    margin-top: 4px;
    margin-inline: calc(var(--margin) * -1);
  }

  @media (min-width: 64em) {
    .rows {
      margin-inline: 0;
    }
  }

  .rows :global([data-course-id][hidden]) {
    display: none;
  }

  .empty {
    padding: 3rem 0;
    color: var(--muted);
  }
</style>
