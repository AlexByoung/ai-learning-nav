---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { t } from '../../i18n';
import { getPaths } from '../../lib/data';
import { withBase } from '../../lib/url';

const paths = await getPaths();
---

<Base title={t.paths.title} description={t.paths.intro}>
  <div class="card-base head">
    <h1 class="bar-title">{t.paths.title}</h1>
    <p class="text-50">{t.paths.intro}</p>
  </div>
  <ul class="list">
    {
      paths.map((path) => (
        <li class="card-base item">
          <div class="body">
            <h2 class="title">
              <a href={withBase(`paths/${path.id}/`)}>{path.title}</a>
            </h2>
            <p class="meta text-50">
              <span class="meta-icon">
                <Icon name="route-outline" />
              </span>
              {t.paths.steps(path.courses.length)}
              <span class="sep">/</span>
              <span
                data-path-progress
                data-course-ids={path.courses.map((s) => s.course.id).join(',')}
                data-template={t.paths.pathProgress('{done}', '{total}')}
              >
                {t.paths.pathProgress(0, path.courses.length)}
              </span>
            </p>
            <p class="desc text-75">{path.description}</p>
            <p class="chain text-30">{path.courses.map(({ course }) => course.title.split(/[:：]/)[0]).join(' → ')}</p>
          </div>
          <a class="btn-regular enter" href={withBase(`paths/${path.id}/`)} aria-label={`${t.paths.enter}：${path.title}`}>
            <Icon name="chevron-right-rounded" />
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .head {
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .head h1 {
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .item {
    position: relative;
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .title {
    position: relative;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .title::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0.35em;
    width: 4px;
    height: 1.1em;
    border-radius: 0 6px 6px 0;
    background: var(--primary);
  }

  .title a {
    color: var(--text-90);
  }

  .title a:hover {
    color: var(--primary);
  }

  .meta {
    display: flex;
    align-items: center;
    margin: 0.75rem 0;
    font-size: 0.9rem;
  }

  .meta .meta-icon {
    margin-right: 0.5rem;
  }

  .sep {
    margin: 0 0.5rem;
    color: var(--meta-divider);
  }

  .chain {
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }

  .enter {
    flex: none;
    align-self: stretch;
    width: 3.25rem;
    border-radius: 0.75rem;
    color: var(--primary);
    font-size: 2rem;
  }

  @media (max-width: 640px) {
    .item {
      padding: 1.25rem;
    }
    .title::before {
      left: -1.25rem;
    }
    .enter {
      display: none;
    }
  }
</style>
