---
import Base from '../../layouts/Base.astro';
import LayerMark from '../../components/LayerMark.astro';
import { t } from '../../i18n';
import { getPaths } from '../../lib/data';
import { withBase } from '../../lib/url';

const paths = await getPaths();
---

<Base title={t.paths.title} description={t.paths.summary}>
  <div class="page wrap">
    <div class="title-row">
      <h1>{t.paths.title}</h1>
      <p class="muted">{t.paths.summary}</p>
    </div>
    <ul class="list">
      {
        paths.map((path) => (
          <li class="item">
            <div class="item-head">
              <h2>
                <a class="link" href={withBase(`paths/${path.id}/`)}>
                  {path.title}
                </a>
              </h2>
              <p class="muted nums">
                {t.paths.steps(path.courses.length)}，
                <span data-path-progress data-course-ids={path.courses.map((s) => s.course.id).join(',')} data-template={t.paths.pathProgress('{done}', '{total}')}>
                  {t.paths.pathProgress(0, path.courses.length)}
                </span>
              </p>
            </div>
            <p class="desc">{path.description}</p>
            <ol class="chain">
              {path.courses.map(({ course }) => (
                <li>
                  <LayerMark layer={course.category} />
                  <span>{course.title}</span>
                </li>
              ))}
            </ol>
            <a class="button" href={withBase(`paths/${path.id}/`)}>
              {t.paths.enter}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: 2rem;
  }

  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .title-row h1 {
    font-size: var(--step-statement);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .list {
    display: grid;
    gap: 4px;
    margin-top: 2.5rem;
  }

  .item {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--surface);
    justify-items: start;
  }

  .item-head h2 {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .item-head p {
    margin-top: 0.5rem;
  }

  .desc {
    max-width: 52ch;
  }

  .chain {
    display: grid;
    gap: 0.6rem;
  }

  .chain li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chain :global(.layer-mark) {
    width: 1.25rem;
    color: var(--ink);
  }
</style>
