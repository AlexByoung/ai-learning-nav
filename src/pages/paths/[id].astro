---
import Base from '../../layouts/Base.astro';
import CourseRow from '../../components/CourseRow.astro';
import { t } from '../../i18n';
import { pictures } from '../../data/pictures';
import { getPaths, type ResolvedPath } from '../../lib/data';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const paths = await getPaths();
  return paths.map((path) => ({ params: { id: path.id }, props: { path } }));
}

const { path } = Astro.props as { path: ResolvedPath };
const firstId = path.courses[0].course.id;
// Break the title before its second clause ("到…") so the headline sets on two lines.
const cut = path.title.indexOf('到');
const titleLines = cut > 0 ? [path.title.slice(0, cut), path.title.slice(cut)] : [path.title];
---

<Base title={path.title} description={path.description}>
  <section class="path-head wrap" aria-labelledby="path-title">
    <h1 id="path-title" class="display lines">
      {titleLines.map((line, i) => (
        <span class="line">
          <span data-line style={`--i:${i}`}>{line}</span>
        </span>
      ))}
    </h1>
    <div class="head-side">
      <p class="lead" data-rise style="--i:2">{path.description}</p>
      <p class="progress nums" data-rise style="--i:3">
        {t.paths.steps(path.courses.length)}，
        <span data-path-progress data-course-ids={path.courses.map((s) => s.course.id).join(',')} data-template={t.paths.pathProgress('{done}', '{total}')}>
          {t.paths.pathProgress(0, path.courses.length)}
        </span>
      </p>
      <p class="actions" data-rise style="--i:4">
        <a class="button" href={`#course-${firstId}`}>{t.nav.start}</a>
        <a class="back link-plain" href={withBase('paths/')}>{t.paths.back}</a>
      </p>
    </div>
  </section>

  <ol class="steps">
    {
      path.courses.map(({ course, note }, i) => {
        const pic = pictures[course.category];
        return (
          <li class="step">
            <figure class="slice" data-slice>
              <img
                src={withBase(pic.file)}
                width={pic.width}
                height={pic.height}
                alt={pic.alt}
                loading={i === 0 ? undefined : 'lazy'}
                decoding="async"
                style={`object-position:${pic.focus}`}
              />
            </figure>
            <div class="step-text wrap">
              <p class="step-layer">{t.layers[course.category].name}</p>
              <p class="step-note" data-reveal>{note}</p>
            </div>
            <div class="step-row wrap">
              <CourseRow course={course} />
            </div>
          </li>
        );
      })
    }
  </ol>
</Base>

<style>
  .path-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 10vw, 9rem);
  }

  @media (min-width: 64em) {
    .path-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .path-head h1 {
      grid-column: 1 / span 7;
    }
    .head-side {
      grid-column: 8 / span 5;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .path-head h1 {
    font-size: var(--step-display);
  }

  .head-side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .lead {
    max-width: 34ch;
  }

  .progress {
    color: var(--muted);
  }

  .steps {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .step {
    display: grid;
    gap: 1.5rem;
  }

  .slice {
    height: clamp(8rem, 22vh, 14rem);
    overflow: clip;
    background: var(--surface);
  }

  .slice img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
  }

  .step-text {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 64em) {
    .step-text {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: baseline;
    }
    .step-layer {
      grid-column: 1 / span 4;
    }
    .step-note {
      grid-column: 5 / span 8;
    }
  }

  .step-layer {
    color: var(--accent);
    font-weight: 500;
  }

  .step-note {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: none;
  }

  .step-row {
    padding-inline: 0;
  }

  @media (min-width: 64em) {
    .step-row {
      padding-inline: var(--margin);
    }
  }
</style>
