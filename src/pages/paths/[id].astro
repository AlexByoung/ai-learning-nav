---
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import Icon from '../../components/Icon.astro';
import { t } from '../../i18n';
import { getPaths, type ResolvedPath } from '../../lib/data';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const paths = await getPaths();
  return paths.map((path) => ({ params: { id: path.id }, props: { path } }));
}

const { path } = Astro.props as { path: ResolvedPath };
---

<Base title={path.title} description={path.description}>
  <div class="card-base head">
    <a class="btn-plain back" href={withBase('paths/')}><Icon name="arrow-back-rounded" />{t.paths.back}</a>
    <h1 class="title">{path.title}</h1>
    <p class="text-75 desc">{path.description}</p>
    <p class="meta">
      <span class="pill">{t.paths.steps(path.courses.length)}</span>
      <span
        class="pill"
        data-path-progress
        data-course-ids={path.courses.map((s) => s.course.id).join(',')}
        data-template={t.paths.pathProgress('{done}', '{total}')}
      >
        {t.paths.pathProgress(0, path.courses.length)}
      </span>
    </p>
  </div>

  <ol class="steps">
    {
      path.courses.map(({ course, note }, i) => (
        <li class="step">
          <div class="rail" aria-hidden="true">
            <span class="num">{i + 1}</span>
          </div>
          <div class="step-body">
            <p class="step-note">
              <span class="step-label">{t.paths.stepLabel(i + 1)}</span>
              {note}
            </p>
            <CourseCard course={course} />
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .head {
    position: relative;
    padding: 1rem 1.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .back {
    height: 2.5rem;
    padding: 0 0.75rem;
    margin-left: -0.75rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
  }

  .title {
    position: relative;
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
  }

  .title::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0.35em;
    width: 4px;
    height: 1.1em;
    border-radius: 0 6px 6px 0;
    background: var(--primary);
  }

  .desc {
    margin-top: 0.5rem;
    max-width: 46rem;
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .pill {
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 0.4rem;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  /* Dashed rail between steps, in the spirit of Fuwari's archive timeline. */
  .rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 1px);
    border-left: 2px dashed var(--line-color);
  }

  .step:first-child .rail::before {
    top: 1rem;
  }

  .step:last-child .rail::before {
    bottom: auto;
    height: 1rem;
  }

  .num {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--card-bg);
    font-weight: 700;
    outline: 5px solid var(--page-bg);
  }

  .step-body {
    padding-bottom: 1.75rem;
    min-width: 0;
  }

  .step-note {
    margin: 0.3rem 0 0.75rem;
    color: var(--text-75);
  }

  .step-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
  }

  @media (max-width: 480px) {
    .head {
      padding: 0.75rem 1.25rem 1.25rem;
    }
    .title::before {
      left: -1.25rem;
    }
    .step {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.5rem;
    }
    .num {
      width: 1.9rem;
      height: 1.9rem;
      font-size: 0.9rem;
    }
  }
</style>
